aws_region  = "us-west-2"
environment = "production"

vpc_id = "vpc-ALTERAR"
private_subnet_ids = [
  "subnet-ALTERAR-A",
  "subnet-ALTERAR-B",
]
allowed_security_group_ids = ["sg-ALTERAR-EKS"]

db_name                  = "oficina"
db_username              = "oficina_admin"
db_engine_version        = "16"
db_instance_class        = "db.t3.micro"
db_allocated_storage     = 20
db_max_allocated_storage = 40
multi_az                 = false
backup_retention_days    = 14
deletion_protection      = false
skip_final_snapshot      = true

# Produção é mais conservadora que homologação: retenção maior de backup e de log.
enabled_cloudwatch_logs_exports = ["postgresql", "upgrade"]
manage_cloudwatch_log_groups    = true
cloudwatch_logs_retention_days  = 14
log_connections                 = true
log_disconnections              = true
log_min_duration_statement_ms   = 1000
log_statement                   = "ddl"

performance_insights_enabled = false
monitoring_interval          = 0

# No AWS Academy, production é um ambiente lógico e descartável: multi_az fica
# false, deletion_protection fica false e skip_final_snapshot fica true para que
# o destroy no fim da sessão do Learner Lab não falhe nem gere custo residual.
#
# Fora do AWS Academy, em uma conta AWS real, use:
#   multi_az                  = true
#   deletion_protection       = true
#   skip_final_snapshot       = false
#   final_snapshot_identifier = "oficina-production-db-final"
# Multi-AZ dobra o custo de instância e o snapshot final passa a ser cobrado
# como armazenamento de backup, por isso não são padrão aqui.
#
# db_password deve ser cadastrada como variável sensível no HCP Terraform.
