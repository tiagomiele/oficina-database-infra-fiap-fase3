aws_region  = "us-west-2"
environment = "production"

vpc_id = "vpc-ALTERAR"
private_subnet_ids = [
  "subnet-ALTERAR-A",
  "subnet-ALTERAR-B",
]
allowed_security_group_ids = ["sg-ALTERAR-EKS"]

db_name                  = "oficina"
db_username              = "oficina_admin"
db_engine_version        = "16"
db_instance_class        = "db.t3.micro"
db_allocated_storage     = 20
db_max_allocated_storage = 40
multi_az                  = true
backup_retention_days     = 14
deletion_protection       = true
skip_final_snapshot       = false
final_snapshot_identifier = "oficina-production-db-final"

# Produção é mais conservadora que homologação: retenção maior de backup e de log.
enabled_cloudwatch_logs_exports = ["postgresql", "upgrade"]
manage_cloudwatch_log_groups    = true
cloudwatch_logs_retention_days  = 14
log_connections                 = true
log_disconnections              = true
log_min_duration_statement_ms   = 1000
log_statement                   = "ddl"

# A configuração central preenche Account ID e License key no HCP Terraform.
rds_newrelic_telemetry_enabled = true
newrelic_region                = "US"

performance_insights_enabled = false
monitoring_interval          = 0

# Este é o perfil de produção real: réplica Multi-AZ, proteção contra exclusão
# e snapshot final obrigatório. No Learner Lab, use o override descartável apenas
# para uma demonstração temporária e restaure este perfil antes da promoção final.
#
# db_password deve ser cadastrada como variável sensível no HCP Terraform.
